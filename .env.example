# Serveur
PORT=8790
PUBLIC_BASE_URL=http://localhost:8790
DATA_DIR=./data
# Secret HMAC des cookies de session et des liens (>= 32 caractères aléatoires)
SESSION_SECRET=change-me-with-32-random-chars-min
# Domaines e-mail autorisés à émettre des documents (vide = tous)
ALLOWED_EMAIL_DOMAINS=trigenys.com
# Identité
BRAND_NAME=Trigenys Sign
BRAND_NAVY=#1A0A0E
BRAND_ORANGE=#872341
BRAND_OFFWHITE=#F5F3F4

# Notifications via Trigenys Notify (vide = mode console : les liens sont journalisés)
NOTIFY_BASE_URL=
NOTIFY_PROJECT=trigenys-sign
NOTIFY_EMAIL_INGEST_KEY=
NOTIFY_WHATSAPP_DIRECT_INGEST_KEY=
# En dev uniquement : renvoyer les liens magiques dans les réponses API
DEV_SHOW_LINKS=1
